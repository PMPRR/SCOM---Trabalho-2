APP_ENV=dev
APP_ADDR=:8080
DATABASE_URL=postgres://scom:change-me@localhost:5432/scom?sslmode=disable
POSTGRES_USER=scom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scom
# Coleta automatica das fontes externas pelo servidor (minimo 10m; 0 desliga).
INGEST_INTERVAL=1h
# Porta do site no computador quando roda pelo compose (make up).
APP_PORT=8080
# CEMADEN (cadastro em https://ped.cemaden.gov.br). Use UMA das duas formas:
#   1. e-mail e senha da PED: o token e obtido e renovado sozinho (recomendado);
#   2. um token gerado a mao: para de funcionar quando expira, em cerca de 4 h.
# Tudo vazio desliga a fonte.
CEMADEN_EMAIL=
CEMADEN_PASSWORD=
CEMADEN_TOKEN=

